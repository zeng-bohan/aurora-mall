{
  "uid": "aurora-mall-overview",
  "title": "aurora-mall 全链路总览",
  "tags": ["aurora-mall"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "QPS（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx 错误数/秒（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{application}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "p99 请求延迟（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "JVM 堆使用（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{application}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "HikariCP 活跃连接",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "hikaricp_connections_active", "legendFormat": "{{application}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "错误日志事件/秒（Loki，按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "sum by (service) (rate({service=~\"aurora-.*\"} |~ \" ERROR \"[1m]))", "legendFormat": "{{service}}", "queryType": "range" }]
    }
  ]
}
